{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "nodemonConfig": {
    "watch": [
      "config",
      "models",
      "routes",
      "services",
      "index.js"
    ],
    "ignore": [
      "data/**",
      "node_modules/**",
      "*.json"
    ],
    "ext": "js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "MERN API server",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "matrix-bot-sdk": "^0.7.1",
    "mongoose": "^9.9.1",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
