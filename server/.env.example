PORT=5001
MONGO_URI=your_mongodb_connection_string_here

# Element / Matrix
MATRIX_HOMESERVER_URL=https://matrix-client.matrix.org
MATRIX_ROOM_ID=!yourRoomId:matrix.org

# Option A (recommended for E2EE): dedicated bot login
# DO NOT use Element Web/App Access Token for encrypted rooms
MATRIX_USER=@bot_dtrader:matrix.org
MATRIX_PASSWORD=your_bot_account_password

# Option B (fallback / temporary): access token
# Only works well for unencrypted rooms, or after password login created session.json
MATRIX_ACCESS_TOKEN=

# Team
DEVELOPERS=Uzair,Mohsin,Saad,Farhan,Faz,Hamza
QA_TEAM=Habiba,Aqeel,Adil

# Schedule (Mon-Fri only, 11:30 AM Pakistan time)
CRON_TIMEZONE=Asia/Karachi
# Only ONE deployment should run crons (Railway production). Set false on local dev.
ENABLE_CRON_SCHEDULER=true
CRON_SCHEDULE=30 11 * * 1-5

# Review reminder (Mon-Fri 6:50 PM Pakistan time)
REMINDER_CRON_SCHEDULE=50 18 * * 1-5

# Personal follow-up DMs for yesterday's missing reviews (Mon-Fri 10:50 AM)
MISSING_REVIEW_PROMPT_CRON_SCHEDULE=50 10 * * 1-5

# Missed review notice in the main room (Mon-Fri 11:20 AM — after follow-ups)
MISSED_REVIEW_CRON_SCHEDULE=20 11 * * 1-5

# Meeting discussion check — one member per pair (Mon-Fri 5:00 PM)
DISCUSSION_PROMPT_CRON_SCHEDULE=0 17 * * 1-5

# AI (OpenRouter) — optional; can also be set from Settings UI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Frontend env — see client/.env.production (VITE_API_URL)

# Map team names to Matrix user IDs (for review tracking)
# Format: Name=@user:server,Name2=@user2:server
MEMBER_MATRIX_MAP=Mohsin=@mohsinashraf:matrix.org

# Personal bot room per member (missing-review follow-ups)
# Format: Name=!roomId:server,Name2=!roomId2:server
MEMBER_ROOM_MAP=Mohsin=!roomId:matrix.org
