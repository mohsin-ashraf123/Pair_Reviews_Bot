{
  "name": "pair-reviews-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Element Pair Review Bot — MERN monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm install --prefix server --omit=dev",
    "install:client": "npm install --prefix client --include=dev",
    "build:client": "npm run build --prefix client",
    "build": "npm run install:client && npm run build:client",
    "start": "node server/index.js"
  }
}
